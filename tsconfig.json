{
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["bun"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // docs/research holds research prototypes, each with its own package.json and dependencies.
  "exclude": ["node_modules", "docs/research"]
}
