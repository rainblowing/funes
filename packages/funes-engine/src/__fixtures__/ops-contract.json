    {
      "name": "put_page",
      "internal": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "vault-relative page path under the star's memory directory, ending .md"
          },
          "content": {
            "type": "string",
            "maxLength": 100000,
            "description": "the whole file: frontmatter and body"
          },
          "base": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "sha256 of the whole file its sender saw; absent = create-once"
          },
          "proposalId": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "description": "optional ULID naming this request (ADR-0010): a retry reuses it, a new request takes a new one; with it the answer is {proposalId, status, reason?, currentHash?, writtenHash?}"
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    },
