          "proposalId": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "description": "ULID naming this request (ADR-0010, edge only): a retry reuses it, a new request takes a new one; with it the answer is {proposalId, status, reason?, currentHash?, writtenHash?}"
