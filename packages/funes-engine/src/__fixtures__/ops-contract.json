          "as_of": {
            "type": "string",
            "description": "when the successor's claim became true (ISO date)"
          },
          "tags": {
            "type": "string",
            "description": "optional comma-separated tags"
          }
        },
        "required": [
          "oldId",
          "title",
          "body"
        ]
      }
