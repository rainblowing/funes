    {
      "name": "remember",
      "internal": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 1000,
            "description": "short title"
          },
          "body": {
            "type": "string",
            "maxLength": 100000,
            "description": "the memory content (markdown); split a longer record into successive memories"
          },
          "type": {
            "type": "string",
            "description": "optional item type (default: memory)"
          },
          "tags": {
            "type": "string",
            "description": "optional comma-separated tags"
          },
          "volatile": {
            "type": "boolean",
            "description": "true if this is a STATE that goes stale and should be replaced by a later write (a rate, a plan); false/omitted for an EVENT, which is append-only. Recorded and returned by recall; supersession is still an explicit act, not automatic"
          },
          "as_of": {
            "type": "string",
            "description": "when this was true (ISO date), if that differs from when it was written"
          },
          "proposalId": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "description": "optional ULID naming this request (ADR-0010): a retry reuses it, a new request takes a new one; with it the answer is {proposalId, status, reason?, currentHash?, writtenHash?}"
          }
        },
        "required": [
          "title",
          "body"
        ]
      }
    },
    {
      "name": "supersede",
      "internal": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "oldId": {
            "type": "string",
            "description": "id of the item to supersede (out_memory/...)"
          },
          "title": {
            "type": "string",
            "maxLength": 1000
          },
          "body": {
            "type": "string",
            "maxLength": 100000
          },
          "type": {
            "type": "string",
            "description": "optional item type"
          },
          "volatile": {
            "type": "boolean",
            "description": "true if the successor is still a STATE that goes stale and should be replaced by a later write; false/omitted records it as an append-only EVENT. Recorded and returned by recall; supersession is still an explicit act, not automatic"
          },
          "as_of": {
            "type": "string",
            "description": "when the successor's claim became true (ISO date)"
          },
          "tags": {
            "type": "string",
            "description": "optional comma-separated tags"
          },
          "proposalId": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "description": "optional ULID naming this request (ADR-0010): a retry reuses it, a new request takes a new one; with it the answer is {proposalId, status, reason?, currentHash?, writtenHash?}"
          }
        },
        "required": [
          "oldId",
          "title",
          "body"
        ]
      }
    },
