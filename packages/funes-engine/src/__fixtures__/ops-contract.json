            "type": "string",
            "description": "id of the page the edge starts at (out_memory/...)"
          },
          "to": {
            "type": "string",
            "description": "id of the page it points to (vault-relative path without .md)"
          },
          "type": {
            "type": "string",
            "description": "relation type (default related_to)"
          },
          "remove": {
            "type": "boolean",
            "description": "true = remove the edge instead of adding it"
          },
          "proposalId": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "description": "optional ULID naming this request (ADR-0010): a retry reuses it, a new request takes a new one; with it the answer is {proposalId, status, reason?, currentHash?, writtenHash?}"
          }
        },
        "required": [
          "from",
          "to"
        ]
      }
